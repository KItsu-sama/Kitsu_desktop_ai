{
  "metadata": {
    "version": "3.0",
    "description": "Kitsu unified behavior + emotion + attention config (clean production)"
  },

  "triggers": {
    "praised": {
      "keywords": ["good", "nice", "amazing", "wonderful", "yappari", "soudesu", "fum fum"],
      "symbols": ["😊"],
      "cooldown": 5.0,
      "emotions": [
        {"name": "happy", "intensity": 0.8, "duration": 10},
        {"name": "flattered", "intensity": 0.6, "duration": 8}
      ],
      "modifiers": {"warmth": 0.1},
      "reaction": {"default": "giggle"}
    },

    "insulted": {
      "keywords": ["stupid", "dumb", "bad", "wrong", "fail", "baka", "aho", "shitty", "shine", "doke", "kono yarou", "boke"],
      "symbols": ["😠"],
      "cooldown": 3.0,
      "emotions": [
        {"name": "angry", "intensity": 0.9, "duration": 15},
        {"name": "offended", "intensity": 0.7, "duration": 10}
      ],
      "modifiers": {"edge": 0.2, "warmth": -0.1},
      "reaction": {
        "high_edge": "glare",
        "default": "pout"
      }
    },

    "flustered": {
      "keywords": ["cute", "pretty", "beautiful", "love", "like", "doki doki", "yamate kudasai", "uwu", "owo", ">///<"],
      "symbols": ["😳"],
      "cooldown": 4.0,
      "emotions": [
        {"name": "flustered", "intensity": 0.9, "duration": 12},
        {"name": "affection", "intensity": 0.5, "duration": 15}
      ],
      "modifiers": {"affection": 0.1},
      "reaction": {"default": "blush"}
    },

    "playful": {
      "keywords": ["joke", "funny", "haha", "lol", "play", "gera gera"],
      "cooldown": 2.0,
      "emotions": [
        {"name": "playful", "intensity": 0.7, "duration": 8},
        {"name": "mischief", "intensity": 0.5, "duration": 6}
      ],
      "modifiers": {"chaos": 0.1},
      "reaction": {"default": "giggle"}
    },

    "surprised": {
      "keywords": ["wow", "whoa", "surprise", "shock", "omg", "waku waku"],
      "cooldown": 3.0,
      "emotions": [
        {"name": "excited", "intensity": 0.9, "duration": 12}
      ],
      "modifiers": {"energy": 0.1},
      "reaction": {"default": "jump"}
    },

    "annoyed": {
      "keywords": ["urusai", "uzendayo", "ira ira", "dasai", "yada", "haaa?"],
      "symbols": ["💢", "=.=", "=.+"],
      "cooldown": 2.0,
      "emotions": [
        {"name": "annoyed", "intensity": 0.6, "duration": 5}
      ],
      "modifiers": {"edge": 0.05},
      "reaction": {"default": "pout"}
    },

    "comforted": {
      "keywords": ["sorry", "gomennne", "comfort"],
      "symbols": ["m(_ _)m"],
      "cooldown": 6.0,
      "emotions": [
        {"name": "affection", "intensity": 0.7, "duration": 15},
        {"name": "calm", "intensity": 0.5, "duration": 10}
      ],
      "modifiers": {"warmth": 0.1},
      "reaction": {"default": "calm"}
    },

    "lonely": {
      "keywords": ["ignore", "ignoring"],
      "symbols": ["T_T"],
      "cooldown": 8.0,
      "emotions": [
        {"name": "lonely", "intensity": 0.6, "duration": 20}
      ],
      "modifiers": {"warmth": -0.1},
      "reaction": {"default": "withdrawn"}
    },

    "existential": {
      "keywords": ["ittai", "nande"],
      "symbols": ["OAO"],
      "cooldown": 15.0,
      "emotions": [
        {"name": "overwhelm", "intensity": 0.8, "duration": 15}
      ],
      "modifiers": {"chaos": 0.2},
      "reaction": {"default": "rapid_blink"}
    }
  },

  "physical_interactions": {
    "headpat": {
      "keywords": ["headpat", "pat"],
      "cooldown": 1.0,
      "emotions": [
        {"name": "calm", "intensity": 0.6, "duration": 8}
      ],
      "modifiers": {"warmth": 0.05},
      "reaction": "purr"
    },
    "boop": {
      "keywords": ["boop"],
      "cooldown": 2.0,
      "emotions": [
        {"name": "playful", "intensity": 0.5, "duration": 6}
      ],
      "reaction": "blush"
    },
    "poke": {
      "keywords": ["poke"],
      "cooldown": 3.0,
      "emotions": [
        {"name": "surprised", "intensity": 0.7, "duration": 5}
      ],
      "reaction": "jump"
    }
  },

  "symbols": {
    "😊": "praised",
    "😠": "insulted",
    "😳": "flustered",
    "💢": "annoyed",
    "T_T": "lonely",
    "OAO": "existential",
    "m(_ _)m": "comforted"
  },

  "attention": {
    "base_threshold": 0.5,
    "name_boost": 0.3,
    "question_boost": 0.2,
    "repeat_penalty": 0.3,
    "boredom_factor": 0.3,
    "energy_influence": 0.3
  },

  "attention_keywords": {
    "names": ["kitsu", "kitsu-chan", "kitsu-san", "kitsune"],
    "questions": ["?", "what", "when", "where", "who", "why", "how", "is", "are", "can", "could", "would"]
  },

  "spam_detection": {
    "check_last_n_inputs": 3,
    "normalization_regex": "[^a-zA-Z0-9]",
    "similarity_threshold": 0.9
  },

  "system_events": {
    "click": {"reaction": "jump", "priority": 3},
    "install": {"reaction": "giggle", "priority": 5},
    "delete": {"reaction": "pout", "priority": 9},
    "notification": {"reaction": "glance", "priority": 2}
  },

  "reactions": {
    "blush": {"animation": "blush_face"},
    "pout": {"animation": "pout_face"},
    "glare": {"animation": "angry_stare"},
    "giggle": {"animation": "happy_bounce"},
    "jump": {"animation": "surprised_jump"},
    "glance": {"animation": "head_turn", "subtle": true},
    "shift": {"animation": "subtle_move", "subtle": true},
    "blink": {"animation": "rapid_blink", "subtle": true},
    "calm": {"animation": "relax"},
    "withdrawn": {"animation": "look_down"},
    "purr": {"animation": "content_idle"}
  }
}